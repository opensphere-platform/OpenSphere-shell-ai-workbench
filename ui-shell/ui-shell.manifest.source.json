{
  "manifestVersion": 3,
  "kind": "subShell",
  "id": "ai-workbench",
  "hostRef": "main",
  "hostApiVersion": "1.0.0",
  "hostCompat": ">=1.0.0 <2.0.0",
  "version": "1.1.2",
  "title": "AI-Workbench",
  "description": "AI-Workbench subShell.",
  "entry": "ui-shell.plugin.js",
  "shellCompat": ">=0.2.0 <0.9.0",
  "sdkVersion": "0.3.1",
  "permissions": [
    "page:register",
    "api:proxy",
    "nav:contribute",
    "search:contribute",
    "manual:contribute",
    "notify:publish"
  ],
  "nav": {
    "band": "Operate",
    "label": "AI-Workbench"
  },
  "designSystem": "clarity",
  "apiBase": "/api/plugins/ai-workbench",
  "renderMode": "esm",
  "contributions": {
    "page": {
      "enabled": true
    },
    "navigation": {
      "enabled": true,
      "mode": "runtime"
    },
    "api": {
      "enabled": true,
      "basePath": "/api/plugins/ai-workbench"
    },
    "cli": {
      "enabled": true,
      "namespace": "ai-workbench",
      "manifestPath": "/admin/native/agent-tools"
    },
    "manual": {
      "enabled": true,
      "sourceId": "opensphere-ai-hub",
      "mode": "runtime"
    },
    "search": {
      "enabled": true,
      "mode": "runtime"
    },
    "notification": {
      "enabled": true,
      "frontend": true,
      "backend": true
    },
    "observability": {
      "enabled": true,
      "logs": true,
      "metrics": true,
      "traces": true
    }
  },
  "dependencies": [
    {
      "id": "backbone-postgres",
      "capability": "data.postgres",
      "type": "resource",
      "requiredFor": "Ready",
      "provider": { "shell": "foundation" },
      "verify": { "probe": "secretKeys", "namespace": "opensphere-system", "ref": "ai-hub-backbone-postgres", "keys": ["host", "port", "user", "password", "dbname"] },
      "resolveRoute": "/p/ai-workbench/cluster-settings"
    },
    {
      "id": "backbone-objectstore",
      "capability": "data.objectstore",
      "type": "resource",
      "requiredFor": "Ready",
      "provider": { "shell": "foundation" },
      "verify": { "probe": "secretKeys", "namespace": "opensphere-system", "ref": "ai-hub-backbone-rustfs", "keys": ["endpoint"] },
      "resolveRoute": "/p/ai-workbench/cluster-settings"
    },
    {
      "id": "pipelines-dspo",
      "capability": "pipeline.dspo",
      "type": "resource",
      "requiredFor": "Activate",
      "manual": true,
      "provider": { "shell": "cluster-manager" },
      "verify": { "probe": "crdInstalled", "ref": "datasciencepipelinesapplications.datasciencepipelinesapplications.opendatahub.io" },
      "resolveRoute": "/p/cluster-manager/add-ons"
    },
    {
      "id": "embedding-route",
      "capability": "ai.substrate.embedding",
      "type": "connection",
      "scope": "operator",
      "requiredFor": "DataChange",
      "provider": { "shell": "foundation", "claim": { "apiVersion": "ai.foundation.opensphere.io/v1alpha1", "kind": "LLMRouteClaim" } },
      "verify": { "probe": "llmRouteEndpoint" },
      "resolveRoute": "/p/foundation/ai/routes"
    },
    {
      "id": "vector-index",
      "capability": "data.vector",
      "type": "resource",
      "requiredFor": "DataChange",
      "provider": { "shell": "foundation" },
      "verify": { "probe": "pgExtension", "ref": "vector" },
      "resolveRoute": "/p/ai-workbench/cluster-settings"
    },
    {
      "id": "external-gpu",
      "capability": "compute.gpu.external",
      "type": "connection",
      "scope": "operator",
      "requiredFor": "DataChange",
      "provider": { "shell": "cluster-manager", "claim": { "apiVersion": "ai.opensphere.io/v1alpha1", "kind": "ComputeBackendClaim" } },
      "verify": { "probe": "computeBackendReady" },
      "resolveRoute": "/p/ai-workbench/compute"
    }
  ]
}
